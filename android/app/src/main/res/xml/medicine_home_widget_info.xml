<?xml version="1.0" encoding="utf-8"?>
<!-- مواصفات ويدجت الشاشة الرئيسية — حجم افتراضي 4×2 خلايا.
     previewImage: أيقونة التطبيق مؤقتاً (يمكن استبدالها بلقطة
     تصميم لاحقاً). updatePeriodMillis: تحديث النظام (~30 دقيقة
     حداً أدنى) — التحديث الفعلي للبيانات من Dart/workmanager. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/medicine_home_widget"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/medicine_home_widget"
    android:description="@string/widget_title"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
