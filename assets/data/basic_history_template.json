    "sections": [
      {
        "section_id": "demographics",
        "title": "Patient Information",
        "fields": [
          {"name": "demo_todays_date", "label": "Today's Date", "type": "text"},
          {"name": "demo_last_physical", "label": "Date of Last Physical Exam", "type": "text"},
          {"name": "demo_first_name", "label": "First Name", "type": "text"},
