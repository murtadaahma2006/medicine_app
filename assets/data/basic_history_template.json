            "name": "hpi_duration",
            "label": "Duration",
            "type": "text"
          },
          {
            "name": "hpi_onset",
            "label": "Onset",
            "type": "dropdown",
            "options": [
              "Sudden",
              "Gradual",
              "Intermittent"
            ]
          },
          {
            "name": "hpi_quality",
            "label": "Quality",
            "type": "dropdown",
            "options": [
              "Sharp",
              "Dull",
              "Aching",
              "Burning",
              "Throbbing",
              "Pressure"
